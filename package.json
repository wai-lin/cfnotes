{
	"name": "cfnotes",
	"private": true,
	"type": "module",
	"imports": {
		"#configs/*": "./configs/*",
		"#lib/*": "./lib/*",
		"#modules/*": "./modules/*",
		"#space/*": "./.space/*"
	},
	"scripts": {
		"postinstall": "space gen",
		"dev": "space dev",
		"build": "space build",
		"deploy": "space deploy",
		"docs": "space docs",
		"test": "vitest run --config configs/vitest.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint -c configs/oxlint.json --ignore-pattern '**/vendor/**'",
		"fmt": "oxfmt -c configs/oxfmt.json '!**/vendor/**'",
		"check": "oxfmt -c configs/oxfmt.json --check '!**/vendor/**' && pnpm run lint && tsc --noEmit"
	},
	"dependencies": {
		"@fontsource/courier-prime": "^5.3.0",
		"@fontsource/noto-sans-myanmar": "^5.3.0",
		"@jitl/quickjs-wasmfile-release-sync": "0.31.0",
		"@lexical/clipboard": "^0.53.0",
		"@lexical/code": "^0.53.0",
		"@lexical/code-shiki": "^0.53.0",
		"@lexical/history": "^0.53.0",
		"@lexical/link": "^0.53.0",
		"@lexical/list": "^0.53.0",
		"@lexical/mark": "^0.53.0",
		"@lexical/markdown": "^0.53.0",
		"@lexical/rich-text": "^0.53.0",
		"@lexical/selection": "^0.53.0",
		"@lexical/table": "^0.53.0",
		"@lexical/utils": "^0.53.0",
		"@shikijs/themes": "^4.6.0",
		"@tabler/icons": "^3.52.0",
		"effect": "^4.1.4",
		"katex": "0.16.22",
		"lexical": "^0.53.0",
		"mermaid": "11.4.1",
		"quickjs-emscripten-core": "0.31.0",
		"shiki": "^4.6.0",
		"spacefn": "^0.11.1",
		"sucrase": "3.35.0"
	},
	"devDependencies": {
		"@alchemy.run/cloudflare": "2.0.0-beta.87",
		"@jitl/quickjs-singlefile-mjs-release-sync": "0.31.0",
		"alchemy": "2.0.0-beta.87",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"spacefn-docs": "^0.11.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
