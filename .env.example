# Copy to .env for local dev. Deploys read .env.<stage> (e.g. .env.prod) or the environment.
# README.md, "Sign in with Google", says how to get these.

# Where the app is reached, with no trailing slash. Google must allow <ORIGIN>/auth/google.
ORIGIN=http://localhost:1337
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in, comma-separated. Everyone listed shares the one workspace.
ALLOWED_EMAILS=
